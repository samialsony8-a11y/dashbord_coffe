<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Barns Maintenance Dashboard</title>

    <style>
        body {
            font-family: Arial;
            background: #f4f6f9;
            margin: 0;
        }

        header {
            background: #12382b;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .container {
            padding: 25px;
        }

        .cards {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 8px #ddd;
            flex: 1;
            min-width: 180px;
            text-align: center;
        }

        .card h2 {
            color: #12382b;
        }

        button {
            background: #12382b;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<header>
    <h1>Barns Dashboard</h1>
    <p>نظام إدارة الصيانة والدعم الفني</p>
</header>

<div class="container">

    <h2>لوحة التحكم الرئيسية</h2>

    <div class="cards">

        <div class="card">
            <h3>إجمالي التذاكر</h3>
            <h2>150</h2>
        </div>

        <div class="card">
            <h3>التذاكر المفتوحة</h3>
            <h2>35</h2>
        </div>

        <div class="card">
            <h3>التذاكر المغلقة</h3>
            <h2>115</h2>
        </div>

        <div class="card">
            <h3>الفنيون</h3>
            <h2>12</h2>
        </div>

    </div>

    <br><br>

    <h2>إدارة طلبات الصيانة</h2>

    <button onclick="alert('سيتم إضافة نموذج التذاكر قريباً')">
        + إنشاء تذكرة جديدة
    </button>

</div>

</body>
</html>
